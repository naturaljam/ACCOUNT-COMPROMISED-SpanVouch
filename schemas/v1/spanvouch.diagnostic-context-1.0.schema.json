          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SpanKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SpanStatus"
        }
      },
      "required": [
        "span_id",
        "name",
        "kind",
        "status",
        "started_at",
        "ended_at"
      ],
      "title": "DiagnosticSpan",
      "type": "object"
    },
    "DiagnosticTraceView": {
      "additionalProperties": false,
      "properties": {
        "spans": {
          "items": {
            "$ref": "#/$defs/DiagnosticSpan"
          },
          "minItems": 1,
