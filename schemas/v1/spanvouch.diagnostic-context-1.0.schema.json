          "type": "array"
        }
      },
      "required": [
        "spans"
      ],
      "title": "DiagnosticTraceView",
      "type": "object"
    },
    "JsonValue": {},
    "SpanKind": {
      "enum": [
        "agent",
        "llm",
        "tool",
        "retrieval",
        "approval",
        "workflow"
      ],
      "title": "SpanKind",
      "type": "string"
    },
    "SpanStatus": {
      "enum": [
        "ok",
        "error",
        "unset"
      ],
      "title": "SpanStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "spanvouch.diagnostic-context",
      "default": "spanvouch.diagnostic-context",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "view": {
      "$ref": "#/$defs/DiagnosticTraceView"
    }
  },
  "required": [
    "trace_id",
    "run_id",
    "view"
