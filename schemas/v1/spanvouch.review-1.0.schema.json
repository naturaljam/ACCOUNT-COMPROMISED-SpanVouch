        },
        "related_span_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Span Ids",
          "type": "array"
        },
        "revisable": {
          "title": "Revisable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
