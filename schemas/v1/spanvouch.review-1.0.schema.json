          "title": "Taxonomy Id",
          "type": "string"
        },
        "taxonomy_version": {
          "minLength": 1,
          "title": "Taxonomy Version",
          "type": "string"
        }
      },
      "required": [
        "taxonomy_id",
        "taxonomy_version"
      ],
      "title": "TaxonomyRef",
      "type": "object"
    },
    "VerificationFinding": {
      "additionalProperties": false,
