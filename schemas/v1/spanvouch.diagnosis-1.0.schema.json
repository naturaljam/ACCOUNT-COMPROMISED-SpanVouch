{
  "$defs": {
    "AbstainReason": {
      "enum": [
        "unsupported_failure_type",
        "insufficient_evidence",
        "ambiguous_findings",
        "invalid_model_output",
        "invalid_evidence_reference"
      ],
      "title": "AbstainReason",
      "type": "string"
    },
    "ClaimStage": {
      "enum": [
        "cause",
        "propagation",
        "outcome"
      ],
      "title": "ClaimStage",
      "type": "string"
    },
    "DiagnosisClaim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/ClaimStage"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "statement",
        "evidence_ids"
      ],
      "title": "DiagnosisClaim",
      "type": "object"
    },
    "DiagnosisProvenance": {
      "additionalProperties": false,
      "properties": {
        "diagnoser_version": {
          "minLength": 1,
          "title": "Diagnoser Version",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Sha256"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "ruleset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ruleset Version"
        },
        "taxonomy": {
          "$ref": "#/$defs/TaxonomyRef"
        }
      },
      "required": [
        "taxonomy",
        "diagnoser_version"
      ],
      "title": "DiagnosisProvenance",
      "type": "object"
    },
    "DiagnosisStatus": {
      "enum": [
        "diagnosed",
        "no_failure",
        "abstained"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "observed_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "field_path",
        "evidence_id",
        "observed_value",
        "value_sha256",
        "description"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "JsonValue": {},
    "ProviderUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "latency_ms"
      ],
      "title": "ProviderUsage",
      "type": "object"
    },
    "TaxonomyRef": {
      "additionalProperties": false,
      "properties": {
        "taxonomy_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Taxonomy Id",
          "type": "string"
        },
        "taxonomy_version": {
          "minLength": 1,
          "title": "Taxonomy Version",
          "type": "string"
        }
      },
      "required": [
        "taxonomy_id",
        "taxonomy_version"
      ],
      "title": "TaxonomyRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstain_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbstainReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "causal_chain": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DiagnosisClaim"
      },
      "maxItems": 3,
      "title": "Causal Chain",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "critical_span_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Critical Span Ids",
      "type": "array"
    },
    "diagnoser": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Diagnoser",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "failure_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    },
    "provenance": {
      "$ref": "#/$defs/DiagnosisProvenance"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "spanvouch.diagnosis",
      "default": "spanvouch.diagnosis",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DiagnosisStatus"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status",
    "confidence",
    "trace_id",
    "run_id",
    "diagnoser",
    "provenance"
  ],
  "title": "DiagnosisReport",
  "type": "object"
}
